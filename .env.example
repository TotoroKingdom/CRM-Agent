# FastAPI database path. Relative paths resolve from the process working directory.
CRM_DATABASE_PATH=./data/crm.sqlite

# Next.js server-side rewrite target. Browser requests remain same-origin at /api/*.
API_INTERNAL_URL=http://127.0.0.1:8000

# Optional only when the browser must call a different API origin directly.
# Leave empty for normal local development through Next.js rewrites.
NEXT_PUBLIC_API_BASE_URL=

LOG_LEVEL=INFO
